DATABASE_URL=postgres://blotato:blotato@localhost:5432/blotato
PORT=3000
# How long GET /posts/:postId/comments serves from the database before
# triggering a fresh fetch via the platform adapter. See docs/ASSUMPTIONS.md.
STALENESS_THRESHOLD_MS=900000

# Optional — only needed to exercise the real GoToSocial integration
# instead of its NotImplementedAdapter stub. See "Testing against a real
# platform" in README.md and scripts/setup-gotosocial.sh.
# GTS_BASE_URL=http://localhost:8080
# GTS_ACCESS_TOKEN=

# Optional — docker-compose reads this same file for variable substitution.
# Override the two accounts docker-compose auto-seeds GoToSocial through
# (see docker-compose.yml's gotosocial-seed service): a poster (the
# "business") and a commenter (someone else engaging with its posts).
# Defaults are fine as-is.
# GTS_SEED_USERNAME=blotato_seed
# GTS_SEED_EMAIL=blotato-seed@example.org
# GTS_SEED_PASSWORD=BlotatoSeed_2026!
# GTS_COMMENTER_USERNAME=blotato_commenter
# GTS_COMMENTER_EMAIL=blotato-commenter@example.org
# GTS_COMMENTER_PASSWORD=BlotatoCommenter_2026!
