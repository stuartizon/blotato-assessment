DATABASE_URL=postgres://blotato:blotato@localhost:5432/blotato
PORT=3000
# How long GET /posts/:postId/comments serves from the database before
# triggering a fresh fetch via the platform adapter. See docs/ASSUMPTIONS.md.
STALENESS_THRESHOLD_MS=900000

# Optional — only needed to exercise the real GoToSocial integration
# instead of its NotImplementedAdapter stub. See "Testing against a real
# platform" in README.md and scripts/setup-gotosocial.sh.
# GTS_BASE_URL=http://localhost:8080
# GTS_ACCESS_TOKEN=
